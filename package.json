{
  "name": "azure-github-runner-demo-app",
  "version": "1.0.0",
  "description": "Cloud-Native Node.js Web Application and Telemetry Service for Azure Self-Hosted Runner and Private AKS Deployment",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "test:ci": "node --test --test-reporter=spec tests/*.test.js"
  },
  "keywords": [
    "azure",
    "github-actions",
    "self-hosted-runner",
    "kubernetes",
    "aks",
    "docker",
    "terraform"
  ],
  "author": "DevOps Engineering Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
