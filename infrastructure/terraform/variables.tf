# ==============================================================================
# General Azure Variables
# ==============================================================================

variable "resource_group_name" {
  type        = string
  description = "Name of the Azure Resource Group where the runner infrastructure will be deployed."
  default     = "rg-github-runner"
}

variable "location" {
  type        = string
  description = "Azure Region for all deployed resources."
  default     = "eastus"
}

variable "environment" {
  type        = string
  description = "Deployment environment name (e.g., dev, staging, prod)."
  default     = "prod"
}

variable "tags" {
  type        = map(string)
  description = "Map of tags to apply to all resources."
  default = {
    Project   = "GitHub-Self-Hosted-Runner"
    ManagedBy = "Terraform"
    Component = "CI-CD-Infrastructure"
  }
}

# ==============================================================================
# Virtual Network & Subnet Variables
# ==============================================================================

variable "vnet_name" {
  type        = string
  description = "Name of the Virtual Network."
  default     = "vnet-github-runner"
}

variable "vnet_address_space" {
  type        = list(string)
  description = "CIDR block(s) for the runner Virtual Network."
  default     = ["10.100.0.0/16"]
}

variable "runner_subnet_name" {
  type        = string
  description = "Name of the dedicated runner Subnet."
  default     = "snet-github-runner"
}

variable "runner_subnet_address_prefix" {
  type        = string
  description = "Address prefix for the runner subnet."
  default     = "10.100.1.0/24"
}

variable "runner_private_ip" {
  type        = string
  description = "Static private IP address for the runner VM within the runner subnet."
  default     = "10.100.1.10"
}

# ==============================================================================
# NAT Gateway Variables
# ==============================================================================

variable "nat_gateway_name" {
  type        = string
  description = "Name of the Azure NAT Gateway providing secure outbound internet connectivity."
  default     = "nat-github-runner"
}

variable "nat_public_ip_name" {
  type        = string
  description = "Name of the Public IP allocated to the Azure NAT Gateway."
  default     = "pip-nat-github-runner"
}

# ==============================================================================
# Runner VM Specifications
# ==============================================================================

variable "runner_vm_name" {
  type        = string
  description = "Name of the Linux Virtual Machine hosting the GitHub self-hosted runner."
  default     = "vm-github-runner-01"
}

variable "runner_vm_size" {
  type        = string
  description = "Azure VM Size / SKU. Default is Standard_B2s, configurable to larger sizes (e.g. Standard_D4s_v5)."
  default     = "Standard_B2s"
}

variable "admin_username" {
  type        = string
  description = "Administrator username for SSH access to the VM."
  default     = "azureuser"
}

variable "ssh_public_key" {
  type        = string
  description = "SSH public key content. If set to null, a 4096-bit RSA key pair will be generated by Terraform."
  default     = null
}

variable "os_disk_type" {
  type        = string
  description = "Storage account type for the OS Disk. Default StandardSSD_LRS (Standard SSD)."
  default     = "StandardSSD_LRS"
}

variable "os_disk_size_gb" {
  type        = number
  description = "Size of the OS Disk in GB."
  default     = 64
}

variable "ubuntu_os_version" {
  type        = string
  description = "Ubuntu 22.04 LTS SKU version."
  default     = "22_04-lts-gen2"
}

variable "runner_user" {
  type        = string
  description = "Dedicated Linux username under which the GitHub Runner service executes."
  default     = "github-runner"
}

variable "runner_version" {
  type        = string
  description = "GitHub Actions Runner binary release version to install."
  default     = "2.321.0"
}

# ==============================================================================
# Private Administration & Bastion Variables
# ==============================================================================

variable "enable_bastion" {
  type        = bool
  description = "Flag to deploy an Azure Bastion Host for secure, private browser-based SSH access without public IPs."
  default     = false
}

variable "bastion_name" {
  type        = string
  description = "Name of the Azure Bastion resource."
  default     = "bas-github-runner"
}

variable "bastion_subnet_address_prefix" {
  type        = string
  description = "Address prefix for AzureBastionSubnet. Must be /26 or larger."
  default     = "10.100.2.0/26"
}

variable "admin_ssh_source_ranges" {
  type        = list(string)
  description = "List of authorized CIDR blocks allowed to connect via SSH (port 22). Default is empty (no external inbound SSH)."
  default     = []
}

# ==============================================================================
# Azure Log Analytics Integration (Optional)
# ==============================================================================

variable "enable_log_analytics" {
  type        = bool
  description = "Enable Azure Log Analytics workspace and Azure Monitor Linux Agent on the runner VM."
  default     = false
}

variable "log_analytics_workspace_id" {
  type        = string
  description = "Existing Log Analytics Workspace Resource ID. If null and enable_log_analytics is true, a new workspace will be created."
  default     = null
}

# ==============================================================================
# VNet Peering & Private AKS Connectivity Variables
# ==============================================================================

variable "enable_aks_vnet_peering" {
  type        = bool
  description = "Enable VNet peering between the runner VNet and the AKS VNet."
  default     = false
}

variable "aks_vnet_id" {
  type        = string
  description = "Resource ID of the remote AKS Virtual Network for VNet peering."
  default     = null
}

variable "aks_vnet_name" {
  type        = string
  description = "Name of the remote AKS Virtual Network (required for two-way peering)."
  default     = null
}

variable "aks_resource_group_name" {
  type        = string
  description = "Resource Group name of the remote AKS Virtual Network (required for two-way peering)."
  default     = null
}

variable "aks_private_dns_zone_id" {
  type        = string
  description = "Resource ID of the Azure Private DNS Zone used by the private AKS cluster (e.g. privatelink.<region>.azmk8s.io)."
  default     = null
}

variable "aks_subnet_address_prefix" {
  type        = string
  description = "Subnet CIDR of the AKS API / nodes to allow in explicit NSG egress rules (optional)."
  default     = null
}

# ==============================================================================
# Role Assignments for Managed Identity
# ==============================================================================

variable "acr_resource_id" {
  type        = string
  description = "Resource ID of the Azure Container Registry (ACR) to grant AcrPush role to the runner Managed Identity."
  default     = null
}

variable "aks_cluster_id" {
  type        = string
  description = "Resource ID of the Azure Kubernetes Service (AKS) cluster to grant Cluster User/Admin role to the runner Managed Identity."
  default     = null
}

variable "key_vault_id" {
  type        = string
  description = "Resource ID of the Azure Key Vault to grant Key Vault Secrets User role to the runner Managed Identity."
  default     = null
}
