# ==============================================================================
# Azure GitHub Self-Hosted Runner - Example Variable Configuration
# Rename this file to terraform.tfvars and update values to match your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# General Azure Settings
# ------------------------------------------------------------------------------
resource_group_name = "rg-github-runner-prod"
location            = "eastus"
environment         = "production"

tags = {
  Project     = "GitHub-Self-Hosted-Runner"
  Environment = "production"
  ManagedBy   = "Terraform"
  Owner       = "DevOps-Team"
}

# ------------------------------------------------------------------------------
# Virtual Network & Runner Subnet
# ------------------------------------------------------------------------------
vnet_name                    = "vnet-github-runner-prod"
vnet_address_space           = ["10.100.0.0/16"]
runner_subnet_name           = "snet-github-runner-prod"
runner_subnet_address_prefix = "10.100.1.0/24"
runner_private_ip            = "10.100.1.10"

# ------------------------------------------------------------------------------
# Azure NAT Gateway (Outbound Internet Connectivity)
# ------------------------------------------------------------------------------
nat_gateway_name   = "nat-github-runner-prod"
nat_public_ip_name = "pip-nat-github-runner-prod"

# ------------------------------------------------------------------------------
# Runner Virtual Machine Configuration
# ------------------------------------------------------------------------------
runner_vm_name    = "vm-gh-runner-01"
runner_vm_size    = "Standard_B2s"   # Configurable: Standard_B2s, Standard_D4s_v5, etc.
admin_username    = "azureuser"
os_disk_type      = "StandardSSD_LRS" # 64 GB Standard SSD
os_disk_size_gb   = 64
ubuntu_os_version = "22_04-lts-gen2"
runner_user       = "github-runner"
runner_version    = "2.321.0"

# Set existing SSH public key, or leave as null to have Terraform generate one
# ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC3... user@workstation"
ssh_public_key = null

# ------------------------------------------------------------------------------
# Private Administration / Azure Bastion
# ------------------------------------------------------------------------------
enable_bastion                 = false # Set to true to deploy Azure Bastion Host
bastion_name                   = "bas-github-runner-prod"
bastion_subnet_address_prefix  = "10.100.2.0/26"

# List of authorized CIDR blocks allowed for SSH (port 22) - e.g. corporate VPN
admin_ssh_source_ranges = []

# ------------------------------------------------------------------------------
# Azure Log Analytics Integration (Optional)
# ------------------------------------------------------------------------------
enable_log_analytics       = false
log_analytics_workspace_id = null # Leave null to create a new workspace if enabled

# ------------------------------------------------------------------------------
# Private AKS Cluster Connectivity & VNet Peering (Optional)
# ------------------------------------------------------------------------------
enable_aks_vnet_peering   = false
# aks_vnet_id             = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-aks-prod/providers/Microsoft.Network/virtualNetworks/vnet-aks-prod"
# aks_vnet_name           = "vnet-aks-prod"
# aks_resource_group_name = "rg-aks-prod"
# aks_private_dns_zone_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-aks-prod/providers/Microsoft.Network/privateDnsZones/privatelink.eastus.azmk8s.io"
# aks_subnet_address_prefix = "10.200.0.0/16"

# ------------------------------------------------------------------------------
# Managed Identity Role Assignments (Optional - CI/CD Integration)
# ------------------------------------------------------------------------------
# acr_resource_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-shared/providers/Microsoft.ContainerRegistry/registries/myacrprod"
# aks_cluster_id  = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-aks-prod/providers/Microsoft.ContainerService/managedClusters/aks-cluster-prod"
# key_vault_id    = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-shared/providers/Microsoft.KeyVault/vaults/kv-shared-prod"
